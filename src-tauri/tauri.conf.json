{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Splitter",
  "version": "0.1.0",
  "identifier": "com.thinhnp.videosplitter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Video Splitter",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
